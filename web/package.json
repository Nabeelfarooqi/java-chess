{
  "name": "rival-room",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "npm run test:migrations && node tests/run.mjs && node tests/app-extras.mjs && node tests/presentation.mjs && node tests/realtime.mjs && node tests/imessage.mjs && npm run test:subdomain",
    "test:migrations": "node tests/migrations.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "cloudflare:setup": "node scripts/cloudflare-setup.mjs setup",
    "cloudflare:deploy": "node scripts/cloudflare-setup.mjs deploy",
    "cloudflare:pins": "node scripts/cloudflare-setup.mjs pins",
    "cloudflare:add-player": "node scripts/cloudflare-setup.mjs add-player",
    "cloudflare:set-pin": "node scripts/set-pin-cli.mjs",
    "imessage:setup": "node scripts/imessage-setup.mjs",
    "imessage:connect": "node scripts/imessage-connect-cli.mjs",
    "imessage:chats": "node scripts/imessage-check-chats.mjs",
    "imessage:groups": "node scripts/imessage-check-chats.mjs --groups",
    "imessage:start": "node scripts/imessage-bridge.mjs",
    "imessage:status": "node scripts/imessage-bridge.mjs status",
    "imessage:retry": "node scripts/imessage-bridge.mjs retry",
    "cloudflare:spectator-pin": "node scripts/spectator-pin-cli.mjs",
    "cloudflare:subdomain": "node scripts/cloudflare-subdomain-cli.mjs",
    "test:subdomain": "node tests/subdomain.mjs && node tests/subdomain-cli.mjs",
    "imessage:memes": "node scripts/meme-cli.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "sharp": "0.35.4"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
